rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isFarmer() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'farmer';
    }

    function isBuyer() {
      return isSignedIn() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'buyer';
    }

    // ===============================================================
    // Users Collection
    // ===============================================================
    
    match /users/{uid} {
      // Users can read their own document
      allow read: if isOwner(uid);
      // Admins can read all users
      allow read: if isAdmin();
      // Users can create their own account on registration
      allow create: if isOwner(uid) && isSignedIn();
      // Users can update their own profile
      allow update: if isOwner(uid);
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Products Collection (with approval workflow)
    // ===============================================================
    
    match /products/{productId} {
      // Anyone can read approved products
      allow read: if resource.data.status == 'approved';
      // Farmers can read their own pending/rejected products
      allow read: if isSignedIn() && resource.data.farmerId == request.auth.uid;
      // Admins can read all products for review
      allow read: if isAdmin();
      
      // Farmers can create new products (starts as 'pending')
      allow create: if isFarmer() && request.resource.data.farmerId == request.auth.uid;
      
      // Farmers can update their own products
      allow update: if isOwner(resource.data.farmerId) && 
                       resource.data.status == 'pending' &&
                       request.resource.data.status == 'pending';
      
      // Only admins can approve/reject products (change status)
      allow update: if isAdmin() && 
                       (request.resource.data.status == 'approved' || 
                        request.resource.data.status == 'rejected');
      
      // Farmers can delete their own pending products
      allow delete: if isOwner(resource.data.farmerId) && resource.data.status == 'pending';
      
      // Admins can delete any product
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Market Listings Collection (with approval workflow)
    // ===============================================================
    
    match /market_listings/{listingId} {
      // Anyone can read approved listings
      allow read: if resource.data.status == 'approved';
      // Admins can read all listings for review
      allow read: if isAdmin();
      
      // Buyers can create new listings (starts as 'pending')
      allow create: if isSignedIn();
      
      // Only admins can approve/reject listings (change status)
      allow update: if isAdmin() && 
                       (request.resource.data.status == 'approved' || 
                        request.resource.data.status == 'rejected');
      
      // Admins can delete
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Tips/Extensão Rural Collection
    // ===============================================================
    
    match /tips/{tipId} {
      // Anyone can read tips
      allow read: if true;
      // Only admins can create tips
      allow create: if isAdmin();
      // Only admins can update tips
      allow update: if isAdmin();
      // Only admins can delete tips
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Orders Collection (transactions)
    // ===============================================================
    
    match /orders/{orderId} {
      // Farmers can read their incoming orders
      allow read: if resource.data.farmerId == request.auth.uid;
      // Buyers can read their own orders
      allow read: if resource.data.buyerId == request.auth.uid;
      // Admins can read all orders
      allow read: if isAdmin();
      
      // Buyers can create orders
      allow create: if isBuyer() && request.resource.data.buyerId == request.auth.uid;
      
      // Farmers can update order status (confirm, ship, deliver)
      allow update: if resource.data.farmerId == request.auth.uid && 
                       (request.resource.data.status == 'confirmed' || 
                        request.resource.data.status == 'shipped' || 
                        request.resource.data.status == 'delivered');
      
      // Buyers can cancel their orders
      allow update: if resource.data.buyerId == request.auth.uid && 
                       request.resource.data.status == 'cancelled';
      
      // Admins can update payment status
      allow update: if isAdmin();
      
      // Only admins can delete orders
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Conversations Collection (real-time chat)
    // ===============================================================
    
    match /conversations/{conversationId} {
      // Participants can read their conversations
      allow read: if request.auth.uid in resource.data.participantIds;
      // Admins can read all conversations (for moderation)
      allow read: if isAdmin();
      
      // Any signed-in user can create conversations
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      
      // Participants can update (last message, unread count)
      allow update: if request.auth.uid in resource.data.participantIds;

      // Messages Subcollection
      match /messages/{messageId} {
        // Participants can read messages
        allow read: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // Admins can read all messages
        allow read: if isAdmin();
        
        // Any participant can send messages
        allow create: if request.auth.uid == request.resource.data.senderId && 
                        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        
        // Users can update read status
        allow update: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
      }
    }

    // ===============================================================
    // Notifications Collection
    // ===============================================================
    
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if resource.data.userId == request.auth.uid;
      // Admins can read all notifications
      allow read: if isAdmin();
      
      // System/backend only creates notifications (no client writes)
      allow create: if false;
      
      // Users can update read status
      allow update: if resource.data.userId == request.auth.uid && 
                       request.resource.data.read == true;
      
      // Users can delete their notifications
      allow delete: if resource.data.userId == request.auth.uid;
    }

    // ===============================================================
    // Reports Collection (moderation)
    // ===============================================================
    
    match /reports/{reportId} {
      // Only admins can read reports
      allow read: if isAdmin();
      // Any signed-in user can file a report
      allow create: if isSignedIn();
      // Only admins can update report status
      allow update: if isAdmin();
      // Only admins can delete reports
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Weather Cache Collection (optional)
    // ===============================================================
    
    match /weather_cache/{province} {
      // Anyone can read weather data
      allow read: if true;
      // Backend/admin only (no client writes)
      allow write: if false;
    }

    // ===============================================================
    // Default: Deny All
    // ===============================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

