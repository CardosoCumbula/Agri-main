rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper functions
    // ===============================================================
    function isAuth() { return request.auth != null; }
    
    function isAdmin() {
      return isAuth() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isFarmer() {
      return isAuth() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'farmer';
    }
    
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    
    function isParticipant(conversationData) {
      return isAuth() && request.auth.uid in conversationData.participantIds;
    }

    // ===============================================================
    // Users
    // ===============================================================
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Products — public read only for approved; farmers create; admin approves
    // ===============================================================
    match /products/{productId} {
      allow read: if resource.data.status == 'approved' || isAdmin() || 
                     (isAuth() && resource.data.farmerId == request.auth.uid);
      allow create: if isFarmer() && 
                       request.resource.data.status == 'pending' &&
                       request.resource.data.farmerId == request.auth.uid;
      allow update: if isAdmin() || 
                       (isAuth() && resource.data.farmerId == request.auth.uid && 
                        resource.data.status == 'pending');
      allow delete: if isAdmin() || 
                       (isAuth() && resource.data.farmerId == request.auth.uid);
    }

    // ===============================================================
    // Market listings — same approval pattern as products
    // ===============================================================
    match /market_listings/{listingId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuth() && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin() || 
                       (isAuth() && resource.data.buyerId == request.auth.uid);
    }

    // ===============================================================
    // Tips — public read; admin write only
    // ===============================================================
    match /tips/{tipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // Orders — buyer or farmer involved can read; buyer creates; farmer or admin updates
    // ===============================================================
    match /orders/{orderId} {
      allow read: if isAuth() && (
        resource.data.buyerId == request.auth.uid || 
        resource.data.farmerId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isAuth() && request.resource.data.buyerId == request.auth.uid;
      allow update: if isAdmin() || 
                       (isAuth() && (
                         resource.data.farmerId == request.auth.uid || 
                         resource.data.buyerId == request.auth.uid
                       ));
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Conversations — only participants can read/write
    // ===============================================================
    match /conversations/{conversationId} {
      allow read, update: if isParticipant(resource.data) || isAdmin();
      allow create: if isAuth() && request.auth.uid in request.resource.data.participantIds;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isParticipant(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data
        ) || isAdmin();
        allow create: if isAuth() && request.auth.uid == request.resource.data.senderId &&
          isParticipant(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data
          );
        allow update: if isAdmin();
        allow delete: if false;
      }
    }

    // ===============================================================
    // Notifications — user reads their own; system/admin writes
    // ===============================================================
    match /notifications/{notifId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ===============================================================
    // Reports — authenticated users create; admin reads/manages
    // ===============================================================
    match /reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }

    // ===============================================================
    // Weather cache — public read; admin write
    // ===============================================================
    match /weather_cache/{province} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===============================================================
    // Default: Deny All
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

