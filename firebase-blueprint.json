{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["farmer", "buyer", "admin"] },
        "location": { "type": "string", "description": "City or Province" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Agricultural product listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "farmerId": { "type": "string", "description": "UID of the farmer" },
        "farmerName": { "type": "string" },
        "title": { "type": "string", "description": "Product name (e.g., Milho Branco)" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["Cereais", "Legumes", "Frutas", "Oleaginosas", "Outros"] },
        "price": { "type": "number", "description": "Price in MZN" },
        "unit": { "type": "string", "enum": ["kg", "saca", "tonelada", "unidade"] },
        "quantity": { "type": "number" },
        "location": { "type": "string", "description": "Where the product is located" },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["available", "sold_out", "archived"] }
      },
      "required": ["farmerId", "title", "category", "price", "unit", "quantity", "location"]
    },
    "Order": {
      "title": "Order",
      "description": "Purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "farmerId": { "type": "string" },
        "productId": { "type": "string" },
        "productTitle": { "type": "string" },
        "quantity": { "type": "number" },
        "totalPrice": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["buyerId", "farmerId", "productId", "quantity", "totalPrice", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Product listings"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchase orders"
    }
  }
}
